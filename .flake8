[flake8]
max-line-length = 88
# E203/W503 conflict with black; black owns line length (E501)
extend-ignore = E203, W503, E501
exclude = .venv, .git, .trees, backend/chroma_db, __pycache__
# app.py installs a warnings filter before importing chromadb (via rag_system)
per-file-ignores = backend/app.py: E402
